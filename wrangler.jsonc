{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elias-bingo-v4",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "durable_objects": {
    "bindings": [
      {
        "name": "BINGO_ROOMS",
        "class_name": "BingoGameRoom"
      }
    ]
  },
  "exports": {
    "BingoGameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
